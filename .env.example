# Database
DATABASE_URL="postgresql://user:password@localhost:5432/shathi_food_db?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="your-auth-secret-here"

# Admin Credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Email / SMTP
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
ORDER_NOTIFY_EMAIL="orders@example.com"

# Public Contact & Social URLs
NEXT_PUBLIC_WHATSAPP="+8801XXXXXXXXX"
NEXT_PUBLIC_FACEBOOK_URL="https://facebook.com/your-page"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/your-page"
NEXT_PUBLIC_CONTACT_EMAIL="contact@example.com"
